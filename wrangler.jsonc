// wrangler.jsonc  (Worker config. Replace the placeholder values.)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "myfiles",
  "main": "cloudflare/worker/index.js",
  "compatibility_date": "2025-09-01",

  // builds the link-preview collage (cloudflare/worker/og.js). Without it the preview falls back to a single image.
  "images": { "binding": "IMAGES" },

  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "myfiles-media" }
  ],

  // every minute: scheduled publish/unpublish. hourly: 7-day purge + abandoned upload cleanup
  "triggers": { "crons": ["* * * * *", "17 * * * *"] },

  // Non-secret settings. Secrets are set with `npx wrangler secret put NAME` (see SETUP.md).
  "vars": {
    "SUPABASE_URL": "https://odfwjqxofnuanmopelbm.supabase.co",
    "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im9kZndqcXhvZm51YW5tb3BlbGJtIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTQwNzY3OTAsImV4cCI6MjEwOTY1Mjc5MH0.a-dRBgLnwzxEuROCuWHctmSvUaGmVzagbJuPPVKQ7VA",
    "R2_ACCOUNT_ID": "70bc605390d7d33c212e93aef6db9b1d",
    "R2_BUCKET_NAME": "myfiles-media",
   "PUBLIC_SITE_URL": "https://myfiles-8cc.pages.dev",
    "ALLOWED_ORIGINS": "https://myfiles-8cc.pages.dev, https://*.myfiles-8cc.pages.dev"
  }
}
